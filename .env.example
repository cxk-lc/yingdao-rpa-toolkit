# 影刀开放 API 凭据（复制为 .env 后填写；.env 已被 .gitignore 忽略）
YD_ACCESS_KEY_ID=
YD_ACCESS_KEY_SECRET=

# 可选：直接把已有 accessToken 传给命令（优先于上面的凭据）
# 仅建议在单次进程/CI 中使用；token 只在内存，不落盘
YD_ACCESS_TOKEN=

# 可选：公有云默认 https://api.yingdao.com，专有云填专属域名
YD_BASE_URL=https://api.yingdao.com

# 可选：单次 HTTP 超时（秒）
YD_TIMEOUT=30

# 可选：轮询间隔与最长等待（秒）
YD_POLL_INTERVAL=30
YD_MAX_POLL_SECONDS=1800

# 可选：默认机器人名称 / 机器人分组 uuid（二选一）
YD_DEFAULT_ACCOUNT_NAME=
YD_DEFAULT_ROBOT_GROUP_UUID=

# 可选：企业版账号后缀。填 @csqy1 或 csqy1 均可（自动补 @）
# 机器人名称不带 @ 时用它补全；查询时也可用 --suffix 临时覆盖
YD_ENTERPRISE_SUFFIX=
