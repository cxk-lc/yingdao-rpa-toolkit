# 影刀开放 API 凭据（复制为 .env 后填写；.env 已被 .gitignore 忽略）
YD_ACCESS_KEY_ID=
YD_ACCESS_KEY_SECRET=

# 可选：公有云默认 https://api.yingdao.com，专有云填专属域名
YD_BASE_URL=https://api.yingdao.com

# 可选：单次 HTTP 超时（秒）
YD_TIMEOUT=30

# 可选：轮询间隔与最长等待（秒）
YD_POLL_INTERVAL=30
YD_MAX_POLL_SECONDS=1800

# 可选：默认机器人名称 / 机器人分组 uuid（二选一）
YD_DEFAULT_ACCOUNT_NAME=
YD_DEFAULT_ROBOT_GROUP_UUID=
